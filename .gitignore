# dependencies
node_modules/

# build output
dist/
src/generated/
*.tsbuildinfo

# vscode-antlr4 extension scratch output (we run antlr-ng, not the extension's jar)
.antlr/

# reference grammars (sparse clone of antlr/grammars-v4 — not our source)
vendor/

# local-only corpus: real compiled SQL copied from our dbt projects.
# NEVER commit — proprietary. Snapshot so dbt re-runs don't disturb our tests.
harness/local/
.superpowers/

# machine-specific corpus path. The resolver reads SQL_CORPUS_DIR from the real
# environment (set it as a user env var — see CLAUDE.md → Corpus location); a
# local .env is an optional personal override, never committed (it held a machine path).
.env

# internal working plan / roadmap (packaging, execution history, open-gap ledger)
# — kept locally under .claude/, not published.
.claude/PLAN.md

# per-feature implementation plans (subagent-driven-development scratch) — same
# reasoning as .claude/PLAN.md above, not project documentation.
.claude/plans/
